			<item>
				<title>CA Gallery</title>
				<link>http://localhost:1313/academic-website/cellular-automaton-gallery/</link>
				<pubDate>Fri, 24 Oct 2025 00:00:00 +0000</pubDate>
				<guid>http://localhost:1313/academic-website/cellular-automaton-gallery/</guid>
				<description>&lt;p&gt;These are some of the Cellular Automaton that I have generated using custom rule sets that I tinkered around with during 2021! Check my Github for the Source Code for all these:&lt;/p&gt;&#xA;&lt;div class=&#34;mosaic-grid&#34; id=&#34;mosaic-0&#34;&gt;&#xA;  &#xA;  &#xA;  &#xA;    &#xA;    &#xA;  &#xA;    &#xA;    &#xA;      &#xA;      &#xA;      &lt;p&gt;&lt;img src=&#34;http://localhost:1313/academic-website/images/ca-gallery/dinosaurs.gif&#34; alt=&#34;Description of gif 1&#34;&gt;&lt;/p&gt;&#xA;    &#xA;  &#xA;    &#xA;    &#xA;      &#xA;      &#xA;      &lt;p&gt;&lt;img src=&#34;http://localhost:1313/academic-website/images/ca-gallery/3x&amp;#43;1.gif&#34; alt=&#34;Description of gif 3&#34;&gt;&lt;/p&gt;&#xA;    &#xA;  &#xA;    &#xA;    &#xA;      &#xA;      &#xA;      &lt;p&gt;&lt;img src=&#34;http://localhost:1313/academic-website/images/ca-gallery/dark.gif&#34; alt=&#34;Description of gif 4&#34;&gt;&lt;/p&gt;&#xA;    &#xA;  &#xA;    &#xA;    &#xA;      &#xA;      &#xA;      &lt;p&gt;&lt;img src=&#34;http://localhost:1313/academic-website/images/ca-gallery/int.gif&#34; alt=&#34;Description of gif 5&#34;&gt;&lt;/p&gt;&#xA;    &#xA;  &#xA;    &#xA;    &#xA;      &#xA;      &#xA;      &lt;p&gt;&lt;img src=&#34;http://localhost:1313/academic-website/images/ca-gallery/z2.gif&#34; alt=&#34;Description of gif 6&#34;&gt;&lt;/p&gt;&#xA;    &#xA;  &#xA;    &#xA;    &#xA;      &#xA;      &#xA;      &lt;p&gt;&lt;img src=&#34;http://localhost:1313/academic-website/images/ca-gallery/bruh.gif&#34; alt=&#34;Chemistry Reaction&#34;&gt;&lt;/p&gt;&#xA;    &#xA;  &#xA;    &#xA;    &#xA;  &#xA;&lt;/div&gt;&#xA;&#xA;&lt;style&gt;&#xA;  .mosaic-grid {&#xA;    column-count: 1;&#xA;    column-gap: 1rem;&#xA;    width: 100%;&#xA;    margin: 2rem 0;&#xA;  }&#xA;&#xA;  @media (min-width: 600px) { .mosaic-grid { column-count: 2; } }&#xA;  @media (min-width: 900px) { .mosaic-grid { column-count: 3; } }&#xA;&#xA;   &#xA;  .mosaic-grid img {&#xA;    width: 100% !important;&#xA;    height: auto !important;&#xA;    display: block !important;&#xA;    margin: 0 0 1rem 0 !important;  &#xA;    break-inside: avoid;&#xA;    border: none !important;&#xA;    padding: 0 !important;&#xA;    box-shadow: none !important;&#xA;    border-radius: 4px;&#xA;    cursor: pointer;&#xA;    transition: transform 0.2s ease-in-out;&#xA;  }&#xA;&#xA;  .mosaic-grid img:hover {&#xA;    transform: scale(1.02);&#xA;  }&#xA;&#xA;   &#xA;  .mosaic-grid p {&#xA;    margin: 0 !important;&#xA;    padding: 0 !important;&#xA;    display: contents;  &#xA;  }&#xA;&#xA;   &#xA;  #mosaic-modal {&#xA;    display: none;&#xA;    position: fixed;&#xA;    z-index: 1000;&#xA;    left: 0;&#xA;    top: 0;&#xA;    width: 100%;&#xA;    height: 100%;&#xA;    overflow: auto;&#xA;    background-color: rgba(0, 0, 0, 0.9);&#xA;    backdrop-filter: blur(8px);&#xA;    justify-content: center;&#xA;    align-items: center;&#xA;    flex-direction: column;&#xA;    padding: 20px;&#xA;  }&#xA;&#xA;  #mosaic-modal-content {&#xA;    max-width: 90%;&#xA;    max-height: 80vh;&#xA;    box-shadow: 0 0 20px rgba(0,0,0,0.5);&#xA;    border: 2px solid var(--primary-color, #fff);&#xA;    border-radius: 4px;&#xA;    object-fit: contain;&#xA;  }&#xA;&#xA;  #mosaic-modal-caption {&#xA;    color: #fff;&#xA;    margin-top: 20px;&#xA;    font-family: inherit;&#xA;    text-align: center;&#xA;    font-size: 1.2rem;&#xA;    max-width: 80%;&#xA;  }&#xA;&#xA;  #mosaic-modal-close {&#xA;    position: absolute;&#xA;    top: 30px;&#xA;    right: 40px;&#xA;    color: #fff;&#xA;    font-size: 40px;&#xA;    font-weight: bold;&#xA;    cursor: pointer;&#xA;    transition: color 0.3s;&#xA;    line-height: 1;&#xA;  }&#xA;&#xA;  #mosaic-modal-close:hover {&#xA;    color: var(--primary-color, #aaa);&#xA;    text-decoration: none;&#xA;  }&#xA;&#xA;  body.modal-open {&#xA;    overflow: hidden;&#xA;  }&#xA;&lt;/style&gt;&#xA;&#xA;&#xA;&lt;script&gt;&#xA;  (function() {&#xA;    &#xA;    function ensureModal() {&#xA;      let modal = document.getElementById(&#34;mosaic-modal&#34;);&#xA;      if (!modal) {&#xA;        modal = document.createElement(&#34;div&#34;);&#xA;        modal.id = &#34;mosaic-modal&#34;;&#xA;        modal.innerHTML = `&#xA;          &lt;span id=&#34;mosaic-modal-close&#34;&gt;&amp;times;&lt;/span&gt;&#xA;          &lt;img id=&#34;mosaic-modal-content&#34;&gt;&#xA;          &lt;div id=&#34;mosaic-modal-caption&#34;&gt;&lt;/div&gt;&#xA;        `;&#xA;        document.body.appendChild(modal);&#xA;&#xA;        const closeBtn = document.getElementById(&#34;mosaic-modal-close&#34;);&#xA;        closeBtn.onclick = closeModal;&#xA;        modal.onclick = function(event) {&#xA;          if (event.target === modal) {&#xA;            closeModal();&#xA;          }&#xA;        };&#xA;&#xA;        document.addEventListener(&#39;keydown&#39;, function(e) {&#xA;          if (e.key === &#34;Escape&#34;) closeModal();&#xA;        });&#xA;      }&#xA;      return modal;&#xA;    }&#xA;&#xA;    function openModal(imgSrc, altText) {&#xA;      const modal = ensureModal();&#xA;      const modalImg = document.getElementById(&#34;mosaic-modal-content&#34;);&#xA;      const caption = document.getElementById(&#34;mosaic-modal-caption&#34;);&#xA;      &#xA;      modal.style.display = &#34;flex&#34;;&#xA;      modalImg.src = imgSrc;&#xA;      caption.innerHTML = altText;&#xA;      document.body.classList.add(&#39;modal-open&#39;);&#xA;    }&#xA;&#xA;    function closeModal() {&#xA;      const modal = document.getElementById(&#34;mosaic-modal&#34;);&#xA;      if (modal) {&#xA;        modal.style.display = &#34;none&#34;;&#xA;        document.body.classList.remove(&#39;modal-open&#39;);&#xA;      }&#xA;    }&#xA;&#xA;    &#xA;    &#xA;    function initMosaic() {&#xA;      const grid = document.getElementById(&#34;mosaic-0&#34;);&#xA;      if (!grid) return;&#xA;      &#xA;      const images = grid.getElementsByTagName(&#39;img&#39;);&#xA;      for (let img of images) {&#xA;        &#xA;        if (img.parentElement &amp;&amp; img.parentElement.tagName === &#39;P&#39;) {&#xA;          img.parentElement.style.breakInside = &#34;avoid&#34;;&#xA;          img.parentElement.style.display = &#34;inline-block&#34;;&#xA;          img.parentElement.style.width = &#34;100%&#34;;&#xA;        }&#xA;        &#xA;        &#xA;        img.addEventListener(&#39;click&#39;, function() {&#xA;          openModal(this.src, this.alt);&#xA;        });&#xA;      }&#xA;    }&#xA;&#xA;    if (document.readyState === &#34;loading&#34;) {&#xA;      document.addEventListener(&#34;DOMContentLoaded&#34;, initMosaic);&#xA;    } else {&#xA;      initMosaic();&#xA;    }&#xA;  })();&#xA;&lt;/script&gt;</description>
			</item>
